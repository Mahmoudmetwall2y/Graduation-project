      "name": "Every Minute",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [
        0,
        160
      ]
    },
    {
      "parameters": {
        "url": "={{(($env.ASCULTICOR_APP_URL || 'http://frontend:3000').replace(/\\/+$/, '')) + '/api/llm?action=process-pending&include_email_payloads=1'}}",
        "options": {},
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Host",
              "value": "={{$env.ASCULTICOR_INTERNAL_HOST_HEADER || ($env.ASCULTICOR_PUBLIC_APP_URL || 'http://frontend:3000').replace(/^https?:\\/\\//, '').replace(/\\/.*$/, '')}}"
            },
            {
              "name": "X-Forwarded-Host",
              "value": "={{$env.ASCULTICOR_INTERNAL_HOST_HEADER || ($env.ASCULTICOR_PUBLIC_APP_URL || 'http://frontend:3000').replace(/^https?:\\/\\//, '').replace(/\\/.*$/, '')}}"
            },
            {
              "name": "X-Forwarded-Proto",
              "value": "https"
            },
            {
              "name": "x-internal-token",
              "value": "={{$env.ASCULTICOR_INTERNAL_API_TOKEN}}"
            }
          ]
        },
        "method": "POST"
      },
      "id": "bc9b22ff-5f38-5cda-9a48-8b0c3d40e5b3",
      "name": "Process Pending Reports",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        260,
        80
      ],
      "alwaysOutputData": true,
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 5000
    },
    {
      "parameters": {
        "jsCode": "if (!$json || typeof $json !== 'object' || Array.isArray($json)) {\n  throw new Error('The AscultiCor report worker returned an invalid response payload');\n}\n\nfor (const field of ['processed', 'failed', 'skipped']) {\n  if (!Number.isFinite(Number($json[field] ?? 0))) {\n    throw new Error(`The report worker returned an invalid ${field} count`);\n  }\n}\n\nconst emails = Array.isArray($json.emails) ? $json.emails : [];\nreturn [{\n  json: {\n    emails,\n    emailCount: emails.length,\n    processed: Number($json.processed || 0),\n    failed: Number($json.failed || 0),\n    skipped: Number($json.skipped || 0),\n    automaticallyQueued: Number($json.automatically_queued || 0),\n    checkedAt: new Date().toISOString(),\n  },\n}];\n"
      },
      "id": "473efb45-e621-56f5-b566-2de4d6832f48",
      "name": "Validate Queue Result",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        500,
        80
      ]
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict",
            "version": 2
          },
          "conditions": [
            {
              "id": "06296c5a-53d9-56dc-b7cd-9539ad7bf88f",
              "leftValue": "={{$json.emailCount}}",
              "rightValue": 0,
              "operator": {
                "type": "number",
                "operation": "gt"
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "dc0d6c9b-4705-56d7-a6e3-6af9544fae96",
      "name": "Emails Ready?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [
        740,
        80
      ]
    },
    {
      "parameters": {
        "jsCode": "const emails = Array.isArray($json.emails) ? $json.emails : [];\nconst seen = new Set();\nconst prepared = [];\n\nfor (const item of emails) {\n  if (!item || typeof item !== 'object') continue;\n  const recipient = String(item.emailTo || '').trim().toLowerCase();\n  const subject = String(item.emailSubject || '').trim();\n  const text = String(item.emailText || '').trim();\n  if (!recipient || !recipient.includes('@') || !subject || !text) continue;\n\n  const dedupeKey = `${item.reportId || item.sessionId || subject}:${recipient}`;\n  if (seen.has(dedupeKey)) continue;\n  seen.add(dedupeKey);\n\n  prepared.push({\n    json: {\n      emailFrom: item.emailFrom || '',\n      emailTo: recipient,\n      emailSubject: subject,\n      emailText: text,\n      emailHtml: item.emailHtml || `<pre style=\"white-space:pre-wrap;font-family:Arial,sans-serif\">${text.replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;')}</pre>`,\n      reportId: item.reportId || null,\n      sessionId: item.sessionId || null,\n      priority: item.priority === 'review' ? 'review' : 'routine',\n      preparedAt: new Date().toISOString(),\n    },\n  });\n}\n\nif (emails.length > 0 && prepared.length === 0) {\n  throw new Error('Report emails were returned, but none passed recipient and payload validation');\n}\n\nreturn prepared;\n"
      },
      "id": "6889d1d8-4f24-5535-b871-6d112b5f91dd",
      "name": "Prepare LLM Report Emails",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        980,
        0
      ]
    },
    {
      "parameters": {
        "sendTo": "={{$json.emailTo}}",
        "subject": "={{$json.emailSubject}}",
        "message": "={{$json.emailHtml}}",
        "emailType": "html",
        "options": {
          "appendAttribution": false
        }
      },
      "id": "7439a336-acf9-58f0-a13d-d5086c9d46a1",
      "name": "Send Gmail",
      "type": "n8n-nodes-base.gmail",
      "typeVersion": 2.1,
      "position": [
        1230,
