# ========================================
# MQTT Broker (Local Development)
# ========================================
# IMPORTANT — REAL ESP32 HARDWARE SETUP:
#   By default, MQTT only listens on the loopback interface (127.0.0.1).
#   A physical ESP32 on the LAN connects to your machine's LAN IP, NOT loopback.
#   If you have a real sensor, change BOTH lines below to 0.0.0.0 (or your LAN IP),
#   then run: docker compose restart mosquitto
#
#   LOCAL DEV (software only):  MQTT_BIND_ADDRESS=127.0.0.1  (safe default)
#   LOCAL + REAL ESP32 on LAN:  MQTT_BIND_ADDRESS=0.0.0.0
#   HOSTINGER VPS + real ESP32: MQTT_BIND_ADDRESS=0.0.0.0  +  open port 1883 in Hostinger firewall
MQTT_USERNAME=asculticor
MQTT_PASSWORD=change-me-in-production-use-strong-password
MQTT_BIND_ADDRESS=127.0.0.1
MQTT_WS_BIND_ADDRESS=127.0.0.1
MQTT_TCP_PORT=1883
MQTT_WS_PORT=9001
MQTT_DEVICE_PASSWORD_PEPPER=replace-with-a-long-random-secret
MQTT_SYNC_INTERVAL_SEC=15

# Device bootstrap / LAN access
# Set DEVICE_BOOTSTRAP_PUBLIC_BASE_URL to the URL reachable by ESP32 devices.
# Example: http://192.168.1.100 or https://asculticor.local
NEXT_PUBLIC_APP_URL=http://192.168.1.10:3000
NEXT_PUBLIC_DEPLOYMENT_MODE=local
NEXT_PUBLIC_DEVICE_BOOTSTRAP_URL=http://192.168.1.10:3000/api/device/bootstrap
NEXT_PUBLIC_MQTT_PUBLIC_HOST=
NEXT_PUBLIC_MQTT_PUBLIC_PORT=1883
NEXT_PUBLIC_MQTT_USE_TLS=false
DEVICE_BOOTSTRAP_URL=http://192.168.1.10:3000/api/device/bootstrap
DEVICE_BOOTSTRAP_PUBLIC_BASE_URL=http://192.168.1.10:3000
MQTT_PUBLIC_HOST=192.168.1.10
MQTT_PUBLIC_PORT=1883
MQTT_PUBLIC_USE_TLS=false
DEVICE_BOOTSTRAP_MQTT_HOST=
DEVICE_BOOTSTRAP_MQTT_PORT=1883
DEVICE_BOOTSTRAP_MQTT_TLS=false

# Reverse proxy / host exposure
FRONTEND_BIND_ADDRESS=0.0.0.0
FRONTEND_PORT=3000
INFERENCE_BIND_ADDRESS=127.0.0.1
INFERENCE_PORT=8000
NGINX_HTTP_BIND_ADDRESS=0.0.0.0
NGINX_HTTP_PORT=80
NGINX_HTTPS_BIND_ADDRESS=0.0.0.0
NGINX_HTTPS_PORT=443
NGINX_SERVER_NAME=localhost
NGINX_SSL_CERT_PATH=/etc/nginx/certs/selfsigned.crt
NGINX_SSL_KEY_PATH=/etc/nginx/certs/selfsigned.key

# ========================================
# ML Model Settings (Optional - Has Defaults)
# ========================================
PCG_SAMPLE_RATE=22050
PCG_TARGET_DURATION=10
PCG_MAX_DURATION=20

# ========================================
# Model Artifact Paths
# ========================================
# The inference service mounts /new-models as a Docker volume.
# See docker-compose.yml: - ./new-models:/new-models:ro
#
# NEW_MODELS_DIR is the base directory for all new trained model artifacts.
NEW_MODELS_DIR=/new-models

# ──────────────────────────────────────────────────────────────────────────────
# Model 1 ─ XGBoost PCG Heart Sound Classifier   [ACTIVE]
# ──────────────────────────────────────────────────────────────────────────────
MODEL_1_PATH=/new-models/Xgboost/heart_sound_xgboost_model.pkl
MODEL_1_SCALER_PATH=/new-models/Xgboost/final_scaler.pkl
# Optional: leave blank if no label_encoder.pkl (uses default 3-class list)
MODEL_1_ENCODER_PATH=
MODEL_1_ENABLED=true
MODEL_1_VERSION=v2.0.0

# ──────────────────────────────────────────────────────────────────────────────
# Model 2 ─ ECG AuscultICor_Final (Multi-Head)   [ACTIVE]
# Architecture: 2-lead ECG + RR features. Input: (500,2), (9,), (500,2) @ 125 Hz
# NOTE: Currently uses a single-lead shim until 2-lead hardware is ready.
#       See TODO(model2-pipeline) in inference.py
# ──────────────────────────────────────────────────────────────────────────────
MODEL_2_PATH=/new-models/ecg_mitbih/FINAL_UNIFIED_MODEL.keras
MODEL_2_META_PATH=/new-models/ecg_mitbih/label_encoder.pkl
MODEL_2_ENABLED=true
MODEL_2_VERSION=v2.0.0

# ──────────────────────────────────────────────────────────────────────────────
# Model 3 ─ CNN Murmur Severity Classifier       [PENDING]
# The team is still preparing this model. Do NOT change MODEL_3_ENABLED=true
# until the model file is placed in /new-models/ and fully tested.
#
# To enable Model 3 when ready:
#   1. Place the model file in /new-models/<severity-model-file>
#   2. Set MODEL_3_PATH=/new-models/<severity-model-file>
#   3. Set MODEL_3_ENABLED=true
#   4. Complete the TODO(model3) steps in inference/app/model_registry.py
#   5. Restart: docker compose restart inference
# ──────────────────────────────────────────────────────────────────────────────
MODEL_3_PATH=/new-models/<pending-severity-model-file>
MODEL_3_ENABLED=false
MODEL_3_VERSION=pending

# ──────────────────────────────────────────────────────────────────────────────
# ECG Signal Parameters (must match FINAL_UNIFIED_MODEL training config)
# IMPORTANT: ECG model was trained on MIT-BIH at 125 Hz with 500-sample windows.
# The inference service resamples the ESP32's 500 Hz capture to 125 Hz automatically.
# Do NOT change ECG_SAMPLE_RATE/ECG_WINDOW_SIZE unless you retrain the model.
# ──────────────────────────────────────────────────────────────────────────────
ECG_SAMPLE_RATE=125
ECG_WINDOW_SIZE=500
ECG_MAX_WINDOWS=12
ECG_MAX_DURATION=60
STREAM_TIMEOUT_SEC=20
METRICS_UPDATE_HZ=10
DEVICE_DEFAULT_SESSION_DURATION_SEC=15

# ========================================
# Model Fallback Mode (Development Only)
# ========================================
# Keep false for real ESP32 presentations. Set true only for offline model-less development.
ENABLE_DEMO_MODE=false

# ========================================
# Logging
# ========================================
LOG_LEVEL=INFO

# Internal API token (for scheduled/background LLM processing endpoint)
INTERNAL_API_TOKEN=replace-with-a-long-random-token
# Internal token for inference /config and /metrics endpoints
INFERENCE_INTERNAL_TOKEN=replace-with-another-long-random-token

# ========================================
# CORS (Frontend URL)
# ========================================
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001
# Docker Compose appends inference,asculticor-inference for internal service health checks.
TRUSTED_HOSTS=*.asculticor.com,localhost,127.0.0.1

# Signup onboarding
# Leave blank to require admin/invite-only onboarding.
DEFAULT_SIGNUP_ORG_ID=

# ========================================
# Rate Limiting (Production Security)
# ========================================
RATE_LIMIT_REQUESTS_PER_MINUTE=60
RATE_LIMIT_AUTH_REQUESTS_PER_MINUTE=5

# ========================================
# Security Headers
# ========================================
SECURITY_HEADERS_ENABLED=true
CSP_POLICY="default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; img-src 'self' data: https:; font-src 'self' data:; connect-src 'self' https://*.supabase.co wss://*.supabase.co;"

# ========================================
# LLM Integration (Optional)
# ========================================
# LLM_PROVIDER controls which report generator is used.
# - demo: template-based reports (default)
# - openai: placeholder for OpenAI integration (implement before use)
# - gemini: placeholder for Gemini integration (implement before use)
LLM_PROVIDER=demo
N8N_EMAIL_PAYLOAD_EXPORT_ENABLED=false

# OPENAI_API_KEY=sk-your-openai-api-key-here
# OPENAI_MODEL=gpt-4
# GOOGLE_API_KEY=your-google-api-key-here
# GEMINI_MODEL=gemini-pro

# ========================================
# n8n (Optional cloud automation profile)
# ========================================
# Used only with: docker compose -f docker-compose.yml -f docker-compose.cloud.yml up -d
N8N_BIND_ADDRESS=127.0.0.1
N8N_PORT=5678
N8N_USER=admin
N8N_PASSWORD=change-me
N8N_ENCRYPTION_KEY=replace-with-a-long-random-secret
GENERIC_TIMEZONE=Africa/Cairo
N8N_WEBHOOK_URL=
N8N_PROXY_HOPS=1

# ========================================
# Edge Function CORS (Optional)
# ========================================
# Comma-separated list of allowed origins for Supabase Edge Functions.
# CORS_ORIGIN=http://localhost:3000,https://your-app.example.com
CORS_ORIGIN=http://localhost:3000
